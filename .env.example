# 複製這個檔案成 .env 再填入真實值（.env 已被 .gitignore 排除）
# Slack tokens
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...

# Google Gemini
# 取得 API Key：https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza...
# 模型選項（免費 tier 都能用）：
#   gemini-2.5-flash   (推薦，快又免費，10 RPM / 250 RPD)
#   gemini-2.5-pro     (最強，免費 tier 限制較嚴)
#   gemini-2.0-flash   (上一代，更高免費額度 15 RPM / 1500 RPD)
GEMINI_MODEL=gemini-2.5-flash

# 目標：要被總結的私密頻道 ID（C 開頭）
TARGET_CHANNEL_ID=C0XXXXXXX

# 接收 DM 的使用者 ID（U 開頭，通常是你自己）
DM_USER_ID=U0XXXXXXX

# 抓取訊息數量上限
HISTORY_LIMIT=50

# 測試用：設成 true 時，bot 啟動就立刻執行一次總結（驗證流程用）
# 預設 false；只在本機驗證流程時臨時打開
TEST_RUN_ON_START=false
